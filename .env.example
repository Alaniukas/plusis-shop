# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (test / sandbox) — Dashboard → Developers → API keys
# Live: pk_live_ / sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (products, orders, waitlist, page_views)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (order emails from info@plusis.lt)
RESEND_API_KEY=re_...

# Admin panel (/admin) — signed cookie auth
ADMIN_PASSWORD=change-me-strong-password

# Optional analytics (loaded only after cookie consent)
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_GA_ID=

# Meta Pixel (loaded only after cookie consent)
NEXT_PUBLIC_META_PIXEL_ID=
